# Copy to .env and fill in. .env is git-ignored; this file is not, so never put
# a real value here.
#
# Run with:  uv run --env-file .env uvicorn server:app --port 8080
# On Railway these are the service's Variables; there is no file.
#
# SANDBOX_TOKEN and TYPESAFE_API_KEY are required. The card decides whether an
# order is ever placed. The Día account is only for local runs.

# ---- the job API -----------------------------------------------------------
# Bearer token the web app sends on /jobs. Any long random string:
#
#     openssl rand -hex 32
#
# Must equal SANDBOX_TOKEN in apps/web/.env.local (or on Vercel). The two
# services share this one value and nothing else.
SANDBOX_TOKEN=

# ---- Jev -------------------------------------------------------------------
# TypeSafe API key. Jev (System One) picks the next action at every step; it
# never sees the credentials below, only "type the password into its field".
TYPESAFE_API_KEY=

# ---- the card -------------------------------------------------------------
# Every order is paid with this card, in the shopper's own Día account. All
# five or none: with none set the run stops at the payment step, the order
# endpoints stay blocked, and the escrow refunds. With all five set the run
# presses "Finalizar compra" and a real card places a real order.
# Never logged, never sent to the model, never in a trace.
CARD_PAN=
CARD_EXPIRY_MONTH=
CARD_EXPIRY_YEAR=
CARD_CVV=
CARD_NAME=

# The cardholder's document number, which Día's card form asks for. Unset,
# the logged-in account's DNI is typed instead (and the run says so).
CARD_DNI=

# Which payment group to use: debit (default) or credit.
# CARD_KIND=debit

# ---- a Día account for local runs ------------------------------------------
# Jobs from the app carry the shopper's own login and never use these. The
# CLI (agent.py) and a POST /jobs without `shopper` log in here instead.
# Typed by the harness and redacted from everything sent to the model, but
# the account holder's name and street address do appear in page text, so
# use an account meant for this.
DIA_ARG_EMAIL=
DIA_ARG_PWD=
DIA_ARG_DNI=

# Postcode the store browses with, and the address checkout uses when the
# account has none saved.
DIA_ARG_POSTCODE=
# DIA_ARG_ADDR_STREET=
# DIA_ARG_ADDR_NUMBER=
# DIA_ARG_ADDR_PHONE=
# DIA_ARG_ADDR_COMPLEMENT=

# ---- optional --------------------------------------------------------------
# Railway sets PORT itself; the Dockerfile defaults to 8080. Leave it unset.
# PORT=8080
