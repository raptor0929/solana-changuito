# Copy to .env and fill in. .env is git-ignored; this file is not, so never put
# a real value here.
#
# Run with:  uv run --env-file .env uvicorn server:app --port 8080
# On Railway these are the service's Variables; there is no file.
#
# Every variable here is required. The service answers 503 on /jobs without
# SANDBOX_TOKEN, and a run fails at login without the Día account.

# ---- the job API -----------------------------------------------------------
# Bearer token the web app sends on /jobs. Any long random string:
#
#     openssl rand -hex 32
#
# Must equal SANDBOX_TOKEN in apps/web/.env.local (or on Vercel). The two
# services share this one value and nothing else.
SANDBOX_TOKEN=

# ---- Jev -------------------------------------------------------------------
# TypeSafe API key. Jev (System One) picks the next action at every step; it
# never sees the credentials below, only "type the password into its field".
TYPESAFE_API_KEY=

# ---- the operator's Día account --------------------------------------------
# The account the sandbox logs into, empties, fills with the basket and walks
# to the card step. No order is ever placed. Typed from here by the harness
# and redacted from everything sent to the model, but the account holder's
# name and street address do appear in page text, so use an account meant
# for this.
DIA_ARG_EMAIL=
DIA_ARG_PWD=
DIA_ARG_DNI=

# Delivery postcode checkout asks for.
DIA_ARG_POSTCODE=

# ---- optional --------------------------------------------------------------
# Railway sets PORT itself; the Dockerfile defaults to 8080. Leave it unset.
# PORT=8080
