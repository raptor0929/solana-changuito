# Copy to .env and fill in. .env is git-ignored; this file is not, so never put
# a real value here.
#
# Run with:  uv run --env-file .env uvicorn server:app --port 8080
# Check the network guard first, no credentials needed:  uv run python selfcheck.py
# On Railway these are the service's Variables; there is no file.
#
# Every variable here is required. The service answers 503 on /jobs without
# SANDBOX_TOKEN, and a run fails at login without the Día account.

# ---- the job API -----------------------------------------------------------
# Bearer token the web app sends on /jobs. Any long random string:
#
#     openssl rand -hex 32
#
# Must equal SANDBOX_TOKEN in apps/web/.env.local (or on Vercel). The two
# services share this one value and nothing else.
SANDBOX_TOKEN=

# ---- Jev -------------------------------------------------------------------
# TypeSafe API key. Jev (System One) picks the next action at every step; it
# never sees the credentials below, only "type the password into its field".
TYPESAFE_API_KEY=

# ---- Jev Ultrafast's text model (checkout) ---------------------------------
# Ultrafast asks Jev which control to use, and asks this OpenAI-compatible model
# only when it has to type into a field during checkout. It sees the page text
# and the field's label — with the account's DNI, email, postal code and
# password already replaced by tags (rules.redact) — and never logs in, so it
# never sees or types a credential. A saved address usually means checkout
# types nothing, but without a key any field that needs text fails the run.
#
# Any OpenAI-compatible endpoint. With an OpenAI key, point it at OpenAI and
# use a small non-reasoning model (ultrafast.py adapts the request):
#
#     TEXT_MODEL_BASE_URL=https://api.openai.com/v1
#     TEXT_MODEL=gpt-4.1-nano
#
# For a reasoning model there (e.g. gpt-5-nano) also set
# TEXT_MODEL_REASONING_EFFORT=minimal.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none

# ---- the operator's Día account --------------------------------------------
# The account the sandbox logs into, empties, fills with the basket and walks
# to the card step. No order is ever placed. Typed from here by the harness
# and redacted from everything sent to the model, but the account holder's
# name and street address do appear in page text, so use an account meant
# for this.
DIA_ARG_EMAIL=
DIA_ARG_PWD=
DIA_ARG_DNI=

# Delivery postcode checkout asks for.
DIA_ARG_POSTCODE=

# ---- optional --------------------------------------------------------------
# Railway sets PORT itself; the Dockerfile defaults to 8080. Leave it unset.
# PORT=8080

# Browser Harness (under Ultrafast) has opt-out telemetry. The Dockerfile sets
# these; set them too when running outside Docker.
BH_TELEMETRY=0
BH_UPDATE_CHECK=0

# The Chromium to launch, when it is not on the PATH (macOS: Google Chrome).
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
