node_modules/
.next/
out/
dist/
build/

# Rust / Soroban
target/
**/*.rs.bk

# Secrets. The treasury key signs mints and settlements; it never lands in git.
# `.env*` rather than `.env` plus `.env*.local`: those two together still let
# .env.production and .env.mainnet through, which is where a DATABASE_URL or a
# live API key is most likely to be written.
.env*
!.env.example
!.env*.example
.secrets/
*.keystore.json

# Generated at deploy time, recorded in deployments.json instead
.stellar/

.DS_Store
*.log

# Playwright (local runs). Reports can contain page snapshots; never commit them.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
e2e/.env
.vercel
*.tsbuildinfo

# Local waitlist signups when no Redis or webhook is configured
apps/landing/.data/

# Soroban writes one JSON per test on every run; useful locally, noise in git
contracts/**/test_snapshots/

# Screen recordings (services/sandbox --record) can show a card being typed. Never commit one.
*.webm
*.mp4
*.mov
