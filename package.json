{
  "name": "changuito",
  "private": true,
  "version": "0.1.0",
  "description": "An agent that shops Argentine supermarkets over MCP and pays from a USDC escrow on Solana devnet.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run dev -w @changuito/web",
    "dev:landing": "npm run dev -w @changuito/landing",
    "build": "npm run build -w @changuito/web",
    "build:landing": "npm run build -w @changuito/landing",
    "start": "npm run start -w @changuito/web",
    "test": "npm test -w @changuito/mcp && npm test -w @changuito/trust && npm test -w @changuito/web && npm test -w @changuito/landing",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:status": "node scripts/db.mjs status",
    "config": "node scripts/config.mjs",
    "db:invariants": "node scripts/db-invariants.mjs",
    "db:archive": "node --experimental-strip-types scripts/db-chat-archive.mts",
    "program:build": "cd anchor/programs/changuito_escrow && cargo build-sbf --tools-version v1.56 --arch v3",
    "deploy:devnet": "./scripts/solana-deploy.sh",
    "devnet:init": "node --experimental-strip-types scripts/solana-init.mts --no-smoke"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1"
  }
}
